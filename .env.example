# Per-asset execution modes are defined in config/strategies.yaml.
# Allowed values are testnet and live; paper and missing modes fail startup.

# Binance Futures Testnet (required only for testnet mode)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=
BINANCE_FUTURES_TESTNET_URL=https://demo-fapi.binance.com

# Binance Futures production (required only when at least one asset uses live mode)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Optional Discord outputs. Empty values disable the corresponding notification.
ORBIT_WEBHOOK_LOGS=
ORBIT_WEBHOOK_ALERTS=
ORBIT_WEBHOOK_SIGNAL=
ORBIT_WEBHOOK_EXCEPTION=
ORBIT_WEBHOOK_MARKET_SENTIMENT=

# Existing external services
MONGODB_URI=mongodb://localhost:27017
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
ORBIT_LOG_FILE=app.log

# Optional daily GitHub issue + Project reporting from the Testnet decision ledger.
# Use a fine-grained token limited to Issues (write) and Projects (write).
ORBIT_GITHUB_REPORTING_ENABLED=false
ORBIT_POST_TRADE_LLM_ENABLED=false
ORBIT_GITHUB_TOKEN=
ORBIT_GITHUB_REPOSITORY=ipankaj18/Orbit
ORBIT_GITHUB_PROJECT_ID=PVT_kwHOBPU1Qs4BhHzU

# Market intelligence uses a provisioned Codex CLI auth.json file.
OPENAI_AUTH_FILE=/run/secrets/codex/auth.json
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_WEB_SEARCH_TIMEOUT=300

# Optional Codex backup using a provisioned Google Antigravity CLI login.
ANTIGRAVITY_TOKEN_FILE=/run/secrets/antigravity-oauth-token
ANTIGRAVITY_PROJECT_FILE=/run/secrets/antigravity-project-id
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_MODEL=gemini-3.7-flash-tiered
ANTIGRAVITY_TIMEOUT=120
